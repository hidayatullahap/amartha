meta {
  name: [Account] Login
  type: http
  seq: 1
}

post {
  url: {{base_url}}/account/login
  body: json
  auth: inherit
}

body:json {
  {
    // available usernames: user1,user2,user3,admin
    "username":"user1"
  }
}

script:post-response {
  bru.setEnvVar("token", res.getBody().token)
}

settings {
  encodeUrl: true
  timeout: 0
}
